/*
    Minimal test profile: synthetic data from test/make_test_data.py
    Resources use withLabel (never withName) so conf/modules.config survives.
*/
params {
    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'

    source_genome     = "${projectDir}/test/data/source.fa"
    target_genome     = "${projectDir}/test/data/target.fa"
    source_gff        = "${projectDir}/test/data/source.gff3"
    target_gff        = "${projectDir}/test/data/target.gff3"
    source_proteins   = "${projectDir}/test/data/source.pep.fa"
    target_proteins   = "${projectDir}/test/data/target.pep.fa"
    qtl_bed           = "${projectDir}/test/data/qtl.bed"
    source_expression = "${projectDir}/test/data/expr_source.tsv"
    target_expression = "${projectDir}/test/data/expr_target.tsv"
    source_name       = 'Norin'
    target_name       = 'Cadenza'
    outdir            = "${projectDir}/test/results"

    region_minimap_args = '-x asm20'
    hit_min_bits        = 30.0
}

process {
    withLabel: process_high   { cpus = 1; memory = '2.GB'; time = '20m' }
    withLabel: process_medium { cpus = 1; memory = '2.GB'; time = '20m' }
    withLabel: process_low    { cpus = 1; memory = '2.GB'; time = '20m' }
}
