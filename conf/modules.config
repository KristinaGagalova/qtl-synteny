/*
    Per-process ext.args.
    NOTE: never set these with `withName` inside a profile-included config -
    a profile withName block REPLACES the selector entry and would silently
    wipe every argument below. Profiles use `withLabel` only.
*/
process {

    withName: 'GENES_SOURCE' {
        ext.args   = { [
            "--feature ${params.gff_feature}",
            "--id-attr ${params.gff_id_attr}",
            params.gff_strip_prefix ? '--strip-prefix' : ''
        ].join(' ') }
        ext.prefix = { "${meta.id}.source" }
    }

    withName: 'GENES_TARGET' {
        ext.args   = { [
            "--feature ${params.gff_feature}",
            "--id-attr ${params.gff_id_attr}",
            params.gff_strip_prefix ? '--strip-prefix' : ''
        ].join(' ') }
        ext.prefix = { "${meta.id}.target" }
    }

    withName: 'MMSEQS_RBH' {
        // args  -> easy-rbh   args2 -> optional easy-search
        ext.args   = { "${params.mmseqs_args}" }
        ext.args2  = { "${params.mmseqs_search_args}" }
        ext.prefix = { "${meta.id}" }
    }

    withName: 'MINIMAP2_INDEX' {
        ext.args = { "${params.minimap2_index_args}" }
    }

    withName: 'EXTRACT_SOURCE_REGION' {
        ext.args = { "--flank ${params.source_flank}" }
    }

    withName: 'MINIMAP2_REGION' {
        ext.args = { "${params.region_minimap_args}" }
    }

    withName: 'RANK_DNA_REGIONS' {
        ext.args = { [
            "--top-n ${params.top_n_regions}",
            "--min-aligned-bp ${params.region_min_aligned}",
            "--min-mapq ${params.region_min_mapq}",
            "--flank ${params.region_flank}"
        ].join(' ') }
    }

    withName: 'MINIPROT_ALIGN' {
        ext.args = { "${params.miniprot_extra}" }
    }

    withName: 'ANNOTATE_REGIONS' {
        ext.args = { "--miniprot-min-ident ${params.miniprot_min_ident}" }
    }

    withName: 'BUILD_SYNTENY_HTML' {
        ext.args = { "--flank ${params.source_flank}" }
    }
}
