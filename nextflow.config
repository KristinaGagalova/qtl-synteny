/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    qtl-synteny Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ---- inputs
    source_genome     = null   // assembly the QTL intervals are defined on
    target_genome     = null
    source_gff        = null
    target_gff        = null
    source_proteins   = null
    target_proteins   = null   // required unless --skip_rbh
    qtl_bed           = null   // chrom  start  end  qtl_id  (BED, 0-based)
    source_expression = null   // gene_id <TAB> sample1 <TAB> sample2 ...
    target_expression = null
    source_annotation = null   // gene_id <TAB> any number of annotation columns, with a header row
    target_annotation = null
    source_name       = null   // display name; defaults to the fasta basename
    target_name       = null
    outdir            = './results'

    // ---- annotation parsing
    // Ensembl/EI 'gene:'/'transcript:' prefixes are stripped automatically,
    // so these rarely need changing. Per-assembly overrides exist because the
    // two annotations do not have to share a convention (e.g. PGSB vs EI).
    gff_feature              = 'mRNA'
    gff_id_attr              = 'ID'
    gff_strip_prefix         = false   // extra: strip ANY leading 'word:'
    source_gff_feature       = null    // default: gff_feature
    source_gff_id_attr       = null
    source_gff_strip_prefix  = null
    target_gff_feature       = null
    target_gff_id_attr       = null
    target_gff_strip_prefix  = null

    // ---- MMseqs2
    // easy-rbh gives reciprocal best hits in a single pass (no reverse run).
    mmseqs_args        = '-s 5.7 -e 1e-5'
    // Optional broader easy-search on top of the RBH set. Worth enabling on a
    // fragmented target, where a true orthologue can lose reciprocity to a
    // tandem duplicate and would otherwise be invisible.
    mmseqs_also_search  = false
    mmseqs_search_args  = '-s 5.7 --max-seqs 50 -e 1e-5'

    // ---- STEP 1/2: syntenic region discovery from DNA alignment
    // The QTL interval is aligned against the WHOLE target; the sequences it
    // hits are ranked by aligned bp. Independent of any protein evidence.
    minimap2_index_args = '-x asm20'
    region_minimap_args = '-x asm20'
    source_flank        = 100000 // bp either side of the QTL, sliced and displayed
    // Region selection: report EVERY target sequence that aligns (after
    // basic identity/length filters), capped only by count. This tool is
    // for QTL inspection on assemblies of any quality, so it shows
    // everything by default rather than deciding for the user.
    top_n_regions       = 0      // 0 = unlimited (default: report all)
    min_pct_id          = 0      // drop targets below this identity first
                                  // (try 97-98 on hexaploid wheat to exclude
                                  // obvious homoeologs before ranking)
    region_min_aligned  = 500    // basic noise filter, not a selection strategy
    region_min_mapq     = 0
    region_flank        = 20000  // bp padding around each displayed target window

    // Paralogy grouping: candidates whose covered SOURCE interval overlaps
    // by at least this fraction are grouped as possible genome copies of one
    // another (relevant on polyploids). The best match within each group is
    // chosen by combined RBH + miniprot evidence once that exists
    // (annotate_regions.py); DNA coverage alone only breaks ties.
    group_overlap_frac  = 0.5

    // Split one target sequence into separate regions when consecutive
    // alignment blocks are further apart than this. Stops a chromosome-scale
    // target collapsing a genuine locus and a distant repeat hit into one
    // giant region (which would also let far-away protein hits count as
    // evidence for that locus). No effect on scaffolds shorter than this.
    cluster_max_gap     = 500000

    // The viewer only draws lanes for scaffolds carrying >=1 RBH or
    // miniprot link - a gene-less scaffold has nothing to inspect here, even
    // if it aligned well. It still appears in regions.tsv/the FASTA output.
    // How a target scaffold earns a lane / a row. See region_passes() in
    // bin/build_synteny_html.py and bin/final_gene_table.py -- both apply
    // this identically, so the HTML views and the gene table never diverge.
    //   'evidence'    (default) only scaffolds with >=1 RBH or miniprot hit
    //   'gene_length' also include scaffolds with an annotated gene and an
    //                 aligned length >= min_gene_region_bp, even with no
    //                 protein evidence -- real synteny that annotation or
    //                 protein-level divergence can hide from RBH/miniprot
    //   'all'         no filtering
    region_display_mode = 'evidence'
    min_gene_region_bp  = 5000

        // ---- STEP 3: miniprot placement of source proteins on the target genome
    skip_miniprot        = false
    miniprot_extra       = '--outn=5'
    miniprot_min_ident   = 0.5   // identity floor for an in-region placement

    // ---- STEP 4: reciprocal best hits between the two annotations
    skip_rbh            = false

    // ---- homoeolog discrimination (hexaploid wheat: A/B/D copies at
    // ~92-96% identity can outrank the true orthologue on coverage alone).
    // A scaffold is called orthologous when this fraction of its genes'
    // reciprocal best hits sit on the QTL's own source chromosome.
    homoeolog_min_frac  = 0.6
    // which evidence decides the call: both | rbh | miniprot
    // 'miniprot' needs no target annotation, so it still resolves scaffolds
    // that are unannotated or poorly annotated
    homoeolog_evidence  = 'both'
    drop_homoeologs     = false  // true = omit them entirely instead of flagging

    // FASTA/list output order: scaffolds carrying annotated genes are listed
    // and written first (ties broken by the selection rank/coverage order).
    // Set false to keep pure rank order instead.
    scaffold_gene_priority = true

    // ---- resources
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '48.h'
}

params.custom_config_base = "."
includeConfig("nfcore_custom.config")
// ----- include contaier runs
includeConfig("conf/containers.config")
includeConfig("conf/modules.config")

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        conda.enabled       = false
    }
    singularity {
        includeConfig 'conf/profiles/singularity.config'
        docker.enabled = false
        conda.enabled  = false
    }
    conda {
        conda.enabled       = true
        conda.useMamba      = true
        docker.enabled      = false
        singularity.enabled = false
    }
    test    { includeConfig 'conf/test.config' }
    slurm   { includeConfig 'conf/slurm.config' }
    pawsey_setonix { includeConfig 'conf/profiles/pawsey_setonix.config' }
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'qtl-synteny'
    description     = 'Interactive pairwise synteny + expression views of QTL regions between two varieties'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

/*
    check_max() lives here (the parent config) so every includeConfig'd file
    can call it. Defining it inside an included file puts it out of scope.
*/
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1
                ? params.max_memory as nextflow.util.MemoryUnit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            return obj.compareTo(params.max_time as nextflow.util.Duration) == 1
                ? params.max_time as nextflow.util.Duration : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
